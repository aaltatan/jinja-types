{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jinja-types:catalog",
  "title": "jinja-types catalog",
  "description": "The output of `Catalog.to_json()` and `jinja-types catalog --format json`.",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "kinds", "namespace", "input_type", "params", "returns", "doc", "examples",
        "source", "replaced", "constant", "classmethod"
      ],
      "properties": {
        "name": {"type": "string", "description": "Qualified name, e.g. `str.zfill`, or a plain helper name."},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["filter", "test", "attribute", "global"]}
        },
        "namespace": {"type": ["string", "null"], "description": "null for plain-name helpers."},
        "input_type": {"type": ["string", "null"], "description": "Type of the piped value; null for globals."},
        "params": {"type": "array", "items": {"$ref": "#/$defs/param"}},
        "returns": {"type": "string"},
        "doc": {"type": "string"},
        "examples": {"type": "array", "items": {"$ref": "#/$defs/example"}},
        "source": {"type": "string", "description": "`jinja_types` or the plugin's entry-point name."},
        "replaced": {"type": "boolean"},
        "constant": {"type": "boolean"},
        "classmethod": {"type": "boolean"}
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "annotation", "default"],
      "properties": {
        "name": {"type": "string"},
        "kind": {
          "enum": ["positional_only", "positional_or_keyword", "var_positional", "keyword_only", "var_keyword"]
        },
        "annotation": {"type": "string"},
        "default": {"type": ["string", "null"], "description": "repr() of the default; null when required."}
      }
    },
    "example": {
      "type": "array",
      "description": "[template, context, expected output]; non-JSON context values are written as repr().",
      "prefixItems": [{"type": "string"}, {"type": "object"}, {"type": "string"}],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
